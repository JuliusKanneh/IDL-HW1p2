   "source": [
    "import os, gc, math\n",
    "import torch\n",
    "import wandb\n",
    "from torch.optim.lr_scheduler import ReduceLROnPlateau\n",
    "\n",
    "# housekeeping\n",
    "torch.cuda.empty_cache()\n",
    "gc.collect()\n",
    "wandb.watch(model, log=\"all\")\n",
    "\n",
    "save_dir = config.get('save_dir', './checkpoints')\n",
    "os.makedirs(save_dir, exist_ok=True)\n",
    "best_path = os.path.join(save_dir, 'best_model.pt')\n",
    "last_path = os.path.join(save_dir, 'last_model.pt')\n",
    "\n",
    "def get_state_dict(m):\n",
    "    return m.module.state_dict() if hasattr(m, 'module') else m.state_dict()\n",
    "\n",
    "def save_checkpoint(path, *, epoch, val_acc, train_acc, tag='best'):\n",
    "    # ensure parent dir exists and path looks like a file\n",
    "    os.makedirs(os.path.dirname(path), exist_ok=True)\n",
    "\n",
    "    checkpoint = {\n",
    "        'epoch': int(epoch),\n",
    "        'model_state_dict': get_state_dict(model),\n",
    "        'optimizer_state_dict': optimizer.state_dict(),\n",
    "        'scheduler_state_dict': scheduler.state_dict() if scheduler is not None else None,\n",
    "        'scaler_state_dict': scaler.state_dict() if (globals().get('scaler', None) is not None) else None,\n",
    "        'val_acc': float(val_acc) if val_acc is not None else None,\n",
    "        'train_acc': float(train_acc) if train_acc is not None else None,\n",
    "        'config': dict(config),\n",
    "        'tag': str(tag),\n",
    "    }\n",
    "    # IMPORTANT: pass object AND path\n",
    "    torch.save(checkpoint, path)\n",
    "\n",
    "# initialize best tracker\n",
    "best_acc = -math.inf\n",
    "\n",
    "for epoch in range(config['epochs']):\n",
    "    print(f\"\\nEpoch {epoch+1}/{config['epochs']}\")\n",
    "\n",
    "    curr_lr               = float(optimizer.param_groups[0]['lr'])\n",
    "    train_loss, train_acc = train(model, train_loader, optimizer, criterion)\n",
    "    val_loss,   val_acc   = eval(model, val_loader)\n",
    "\n",
    "    print(f\"\\tTrain Acc {train_acc*100:.04f}%\\tTrain Loss {train_loss:.04f}\\t Learning Rate {curr_lr:.07f}\")\n",
    "    print(f\"\\tVal   Acc {val_acc*100:.04f}%\\tVal   Loss {val_loss:.04f}\")\n",
    "\n",
    "    wandb.log({\n",
    "        'train_acc': train_acc*100, 'train_loss': train_loss,\n",
    "        'val_acc': val_acc*100,     'valid_loss': val_loss,\n",
    "        'lr': curr_lr\n",
    "    })\n",
    "\n",
    "    # Step the scheduler correctly\n",
    "    if scheduler is not None:\n",
    "        if isinstance(scheduler, ReduceLROnPlateau):\n",
    "            # Typically you pass val_loss to ReduceLROnPlateau\n",
    "            scheduler.step(val_loss)\n",
    "        else:\n",
    "            scheduler.step()\n",
    "\n",
    "    # remove debugger break unless you truly want to stop here\n",
    "    # import pdb; pdb.set_trace()\n",
    "\n",
    "    # always save \"last\"\n",
    "    save_checkpoint(last_path, epoch=epoch, val_acc=val_acc, train_acc=train_acc, tag='last')\n",
    "\n",
    "    # save \"best\"\n",
    "    if val_acc > best_acc:\n",
    "        best_acc = val_acc\n",
    "        save_checkpoint(best_path, epoch=epoch, val_acc=best_acc, train_acc=train_acc, tag='best')\n",
    "        print(f\"New best accuracy: {best_acc*100:.04f}%. Saved to {best_path}\")\n",
    "\n",
    "        # log checkpoint to W&B\n",
    "        ckpt_art = wandb.Artifact('checkpoint', type='checkpoint')\n",
    "        ckpt_art.add_file(best_path)\n",
    "        wandb.run.log_artifact(ckpt_art)\n",
    "\n",
    "        # (optional) log any other files you actually have\n",
